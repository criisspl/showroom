// Configuración de Cloudflare Workers: sirve la web y la IA integrada.
// La clave NO va aquí: se guarda como secreto (IA_CLAVE) en el panel de Cloudflare.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "armario",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Máximo 8 peticiones a la IA por minuto y por persona
  "ratelimits": [{ "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } }],
  "vars": {
    // Proveedor principal: Groq (plan gratuito, modelo con visión)
    "IA_URL": "https://api.groq.com/openai/v1/chat/completions",
    "IA_MODELO": "meta-llama/llama-4-scout-17b-16e-instruct",
    // Reserva opcional si Groq se satura: Mistral (necesita el secreto IA2_CLAVE)
    "IA2_URL": "https://api.mistral.ai/v1/chat/completions",
    "IA2_MODELO": "mistral-small-latest"
  },
  "observability": { "enabled": true }
}
