{
  "name": "armario",
  "version": "1.0.0",
  "description": "Asesora de imagen y armario virtual con IA: análisis de color, cuerpo y estilo, y outfits con tu propia ropa.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite build && wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "vite build && wrangler deploy",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "4.149.0"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/caprasimo": "5.3.0",
    "@fontsource/caveat": "5.3.0"
  }
}
