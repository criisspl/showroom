{
  "name": "armario",
  "version": "1.0.0",
  "description": "Asesora de imagen y armario virtual con IA: análisis de color, cuerpo y estilo, y outfits con tu propia ropa.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite build && wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "vite build && wrangler deploy",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.157.0"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/caprasimo": "5.3.0",
    "@fontsource/caveat": "5.3.0"
  }
}
