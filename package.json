{
  "name": "armario",
  "version": "1.0.0",
  "description": "Asesora de imagen y armario virtual con IA: análisis de color, cuerpo y estilo, y outfits con tu propia ropa.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite build && wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.js\"",
    "deploy": "vite build && wrangler deploy",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-include=\"src/lib/**\" --test-coverage-include=\"worker/**\" \"test/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/caprasimo": "5.3.0",
    "@fontsource/caveat": "5.3.0"
  }
}
